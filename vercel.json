{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].py": {
      "maxDuration": 60,
      "includeFiles": "{backend/app/**,artifacts/models/*.joblib,artifacts/metrics/evaluation.json,artifacts/metrics/delay_evaluation.json,data/processed/port_daily.csv,data/processed/data_quality.json,data/manifests/provenance.json}",
      "excludeFiles": "{backend/tests/**,frontend/**,scripts/**,docs/**,reports/**,data/synthetic/**,data/uploads/**,data/raw/**,artifacts/metrics/*.png,artifacts/metrics/evaluation_pre_*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
